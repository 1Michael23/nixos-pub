#!/usr/bin/env bash
set -euo pipefail

INTERVAL="${WAYBAR_PERF_INTERVAL:-5}"

ICON_CPU="$(printf '\uf2db')"   # fa-microchip
ICON_RAM="$(printf '\uf538')"   # fa-memory
ICON_TEMP="$(printf '\uf2c7')"  # fa-thermometer-full

# Snapshot total/idle jiffies from /proc/stat (idle includes iowait).
cpu_snapshot() {
  awk 'NR==1 {
    idle=$5+$6
    total=$2+$3+$4+$5+$6+$7+$8+$9
    print total, idle
  }' /proc/stat
}

read -r prev_total prev_idle < <(cpu_snapshot)

while true; do
  # --- CPU (delta from previous sample) ------------------------------------
  read -r total idle < <(cpu_snapshot)
  d_total=$((total - prev_total))
  d_idle=$((idle - prev_idle))
  if ((d_total > 0)); then
    cpu=$(((100 * (d_total - d_idle)) / d_total))
  else
    cpu=0
  fi
  prev_total=$total
  prev_idle=$idle

  # --- Load average --------------------------------------------------------
  read -r load1 load5 load15 _ < /proc/loadavg

  # --- Memory + swap -------------------------------------------------------
  mem_total=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  mem_avail=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
  mem_total_mb=$((mem_total / 1024))
  mem_used_mb=$(((mem_total - mem_avail) / 1024))
  mem_pct=$(((100 * (mem_total - mem_avail)) / mem_total))

  swap_total=$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo)
  swap_free=$(awk '/^SwapFree:/ {print $2}' /proc/meminfo)
  if ((swap_total > 0)); then
    swap_used_mb=$(((swap_total - swap_free) / 1024))
    swap_pct=$(((100 * (swap_total - swap_free)) / swap_total))
  else
    swap_used_mb=0
    swap_pct=0
  fi

  # --- Temperature ----------------------------------------------------------
  # Prefer the CPU die sensor (k10temp on AMD, coretemp on Intel); fall back
  # to the max thermal_zone reading when no dedicated CPU hwmon exists.
  temp_c=0
  for hwmon in /sys/class/hwmon/hwmon*; do
    name="$(cat "$hwmon/name" 2>/dev/null)" || continue
    case "$name" in
      k10temp | coretemp | zenpower)
        for f in "$hwmon"/temp*_input; do
          [[ -r "$f" ]] || continue
          v="$(cat "$f" 2>/dev/null)" || continue
          v=$((v / 1000))
          ((v > temp_c)) && temp_c=$v
        done
        ;;
    esac
  done
  if ((temp_c == 0)); then
    for zone in /sys/class/thermal/thermal_zone*/temp; do
      [[ -r "$zone" ]] || continue
      v="$(cat "$zone" 2>/dev/null)" || continue
      v=$((v / 1000))
      ((v > temp_c)) && temp_c=$v
    done
  fi

  # --- Disk -----------------------------------------------------------------
  disk_root="$(df -h / | awk 'NR==2 {print $3" / "$2" ("$5")"}')"
  if df -P /home >/dev/null 2>&1 \
    && [ "$(df -P /home | awk 'NR==2 {print $6}')" != "$(df -P / | awk 'NR==2 {print $6}')" ]; then
    disk_home="$(df -h /home | awk 'NR==2 {print $3" / "$2" ("$5")"}')"
  else
    disk_home=""
  fi

  # --- Top processes --------------------------------------------------------
  top_cpu="$(ps -eo pid,comm,%cpu --sort=-%cpu 2>/dev/null | head -n 6 | awk 'NR>1 {printf "%5s  %-15s %6s%%\n", $1, $2, $3}')" || true
  top_mem="$(ps -eo pid,comm,rss --sort=-rss 2>/dev/null | head -n 6 | awk 'NR>1 {printf "%5s  %-15s %6d MiB\n", $1, $2, $3/1024}')" || true

  # --- State class ----------------------------------------------------------
  class="ok"
  if ((cpu >= 90 || mem_pct >= 90)); then
    class="critical"
  elif ((cpu >= 80 || mem_pct >= 80)); then
    class="warning"
  fi

  # --- Bar text -------------------------------------------------------------
  text="${ICON_CPU} ${cpu}% ${ICON_RAM} ${mem_pct}%"
  if ((temp_c > 0)); then
    text="${text} ${ICON_TEMP} ${temp_c}°C"
  fi

  # --- Tooltip --------------------------------------------------------------
  tooltip="CPU: ${cpu}%   Load: ${load1} / ${load5} / ${load15}"
  tooltip+=$'\n'"RAM: ${mem_used_mb}/${mem_total_mb} MiB (${mem_pct}%)"
  tooltip+=$'\n'"Swap: ${swap_used_mb} MiB (${swap_pct}%)"
  tooltip+=$'\n'"Disk /: ${disk_root}"
  if [[ -n "$disk_home" ]]; then
    tooltip+=$'\n'"Disk /home: ${disk_home}"
  fi
  tooltip+=$'\n'$'\n'"Top CPU:"$'\n'"${top_cpu}"
  tooltip+=$'\n'"Top MEM:"$'\n'"${top_mem}"

  jq -cn \
    --arg text "$text" \
    --arg tooltip "$tooltip" \
    --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'

  sleep "$INTERVAL"
done
